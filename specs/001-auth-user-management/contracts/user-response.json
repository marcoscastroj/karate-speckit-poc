{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserResponse",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "title": "Id"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "is_active": {
      "type": "boolean",
      "title": "Is Active"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At"
    }
  },
  "required": [
    "id",
    "email",
    "is_active",
    "created_at"
  ],
  "additionalProperties": false
}
