# Exemplo de variaveis de ambiente e credenciais locais para o Karate DSL
# Copie este arquivo para .env (ou passe via -D na linha de comando / env vars)
# NUNCA versione senhas ou tokens reais no Git.

API_KEY=default-dev-key
AUTH_TOKEN=default-dev-token
API_USERNAME=dev-user
API_PASSWORD=dev-secret
